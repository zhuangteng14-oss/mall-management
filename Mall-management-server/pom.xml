<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>
    <groupId>com.minke</groupId>
    <artifactId>Mall-management-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Mall-management-server</name>
    <description>Mall-management-server</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>17</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.33</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.46</version>
            <scope>provided</scope>
        </dependency>

        <!-- 缓存抽象（@Cacheable 注解支持） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- Caffeine 本地缓存（一级） -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Redis 客户端（二级） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Lettuce 连接池（spring.data.redis.lettuce.pool.* 生效前提） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- 可观测性（C1）：Actuator 提供 /actuator/metrics 等端点，Micrometer 由它带入
             （micrometer-core 是 starter 的传递依赖，无需单独声明；不引入 Prometheus registry
             —— 本项目没有拉取式抓取方，加它只是多一个依赖）。埋点见 MallCacheMetrics。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 校验层（笔 3）：提供 Hibernate Validator（JSR-380 实现），即 Spring 的 Validator bean。
             ⚠️ 只为「控制器方法参数上的约束注解」供 bean —— 不在任何 Controller 上加**类级**
             {@code @Validated}：那会经 MethodValidationPostProcessor 建 CGLIB 代理，被
             MallManagementApplicationTests 的 4 条 xxxControllerIsNotAopProxied 断言禁止。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 分布式锁（B2）：Redisson 的**核心**包，刻意不用 redisson-spring-boot-starter。
             理由不是风格偏好：starter 的 RedissonAutoConfigurationV2 会注册自己的
             RedissonConnectionFactory，而 Boot 的 Lettuce 工厂是
             @ConditionalOnMissingBean(RedisConnectionFactory.class) ⇒ **Lettuce 被静默顶掉**
             （a3 的连接池与 spring.data.redis.timeout 一并失效，且 A3 上看不出来）——
             与 L2ProbeConfig 类注释警告的是同一种失效形态。核心包绕开自动装配，配置从
             RedisProperties 派生（同源 ⇒ 不存在「改了配置只改一处」的漂移）。
             同理不引 redisson-spring-data-34：那是给 Redisson 版 CacheManager /
             ConnectionFactory 用的，本项目两个都不需要。

             版本 3.46.0 的取舍（依据可复核）：Boot 3.4.5 的 dependencyManagement 把
             io.netty 统一到 4.1.119.Final（spring-boot-dependencies-3.4.5.pom:154），
             而 Maven Central 上 redisson-parent 声明的是 3.46.0 → 4.1.118（被向上抬，
             补丁级、向后兼容）、3.47.0~3.50.0 → 4.1.121（会被**向下**压到 4.1.119）——
             降级方向才是 NoSuchMethodError 的风险面，故取 3.46.0。
             复核命令：./mvnw dependency:tree -Dincludes=io.netty 应显示 4.1.119.Final。 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>3.46.0</version>
        </dependency>

        <!-- 慢 SQL 观测（C3 块 7 · commit 6b · 批文 Q4「丁」）：给 DataSource 包一层，按耗时打 WARN。
             装配点 shared/sql/SlowSqlConfig.java；为什么自己写 listener 而不用库自带的
             logSlowQueryBySlf4j（会丢 traceId + 每条查询排一个定时任务）见 SlowSqlListener 类注释。

             ⚠️ 版本为什么是 1.11.0，而不是「当时最新」的 1.11.1：本机 Maven 走 aliyun 镜像
             （~/.m2/settings.xml 的 mirrorOf=central），而该镜像**没收录** 1.11.1 ——
             2026-10-14 实测该 jar 在 aliyun 上 404、1.11.0 为 200；同一时刻 Central 直连两版都在。
             取「本机能装到 且 CI 也能装到」的交集 ⇒ 1.11.0。
             ⚠️ 别只看 aliyun 的 maven-metadata.xml：它写的 <release> 是 1.11.1（**元数据比产物新**），
             照它写版本号会得到一个装不上的依赖。
             复核：curl -sI https://maven.aliyun.com/repository/public/net/ttddyy/datasource-proxy/1.11.0/datasource-proxy-1.11.0.jar -->
        <dependency>
            <groupId>net.ttddyy</groupId>
            <artifactId>datasource-proxy</artifactId>
            <version>1.11.0</version>
        </dependency>

        <!-- 消息队列（C3 块 7 · commit 8c）：观测事件台账的异步出口。
             ⚠️ 只引 starter，不单独引 spring-rabbit —— starter 负责装配 RabbitTemplate 与
             SimpleRabbitListenerContainerFactory（后者按 application-*.properties 生效）；
             拓扑（exchange / queue / DLQ）与两处 Jackson2JsonMessageConverter 见
             observe/mq/RabbitObserveConfig.java 的类注释。
             ⚠️ a3 profile 刻意 **不配** spring.rabbitmq.*：连不上只 WARN 降级（MQ 缺席不算故障，
             见 RabbitEventPublisher 类注释）；CI 由 ci.yml 的 services 里 rabbitmq:3-management 顶上。
             ⚠️ 追加在依赖段末尾是刻意的：pom.xml 被全仓以 file:行号 互引（`:40` / `:51` / `:72` /
             `:82-85` / `:117-121` 等），插在中间会让其后所有引用集体偏移。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- AOP 织入面（D 段 · commit 2 · A 档 A1）：熔断注解 @CircuitBreaker 要生效，必须有人
             把代理织出来。⚠️ 显式写出来而不是指望 resilience4j-spring-boot3 传递带入 ——
             传递依赖一被上游改 POM 就会静默消失，而那时熔断会**安静地不生效**
             （注解在、代理不在，编译测试全绿），是本段最不想留的那种失效。
             版本由 Boot 的 dependencyManagement 给，不写 version。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- 限流 + 熔断（D 段 · commit 2 · A 档 A1）：只引 starter，局部类（ProtectionGate /
             InboundRateLimitFilter / ProtectionMetrics）都在本仓，见 protect/ 包。
             ⚠️ 版本必须**显式写**：Boot 3.4.5 的 spring-boot-dependencies 里
             **没有** resilience4j 的 dependencyManagement（2026-10-15 实测：该 pom 内
             grep resilience4j 零命中）⇒ 不写 version 会当场解析失败，不是「取最新」。
             ⚠️ 版本为什么是 2.3.0 而不是当时最新的 2.4.0（依据可复核）：resilience4j 2.3.0
             对的是 Spring Boot 3.4 线、2.4.0 对的是 3.5 线，而本仓 parent 是 3.4.5
             （pom.xml:7-8）；跨线取新会引一个只被 3.5 验证过的 starter。
             复核：curl -sI https://repo1.maven.org/maven2/io/github/resilience4j/resilience4j-spring-boot3/2.3.0/resilience4j-spring-boot3-2.3.0.jar
             ⚠️ 追加在依赖段末尾是刻意的：pom.xml 被全仓以 file:行号 互引，插在中间会让其后
             所有引用集体偏移（同上面 amqp 那一族的处置）。 -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>2.3.0</version>
        </dependency>

        <!-- 死锁重试（D 段 · 阶段 2b · A 档 A5）：MerchantDowngradeService.relist 用编程式
             RetryTemplate 兜住 MySQL 1213（不是注解 @Retryable —— 理由见那处 relist 的 javadoc：
             重试要接 ProtectionGate 的 retry 开关，编译期注解读不到运行时开关）。
             ⚠️ 版本由 Boot 3.4.5 的 spring-boot-dependencies 给（2026-10-15 实测：该 pom 里
             grep spring-retry 有 dependencyManagement 命中），不写 version。
             ⚠️ 追加在依赖段末尾是刻意的：pom.xml 被全仓以 file:行号 互引，插在中间会让其后
             所有引用集体偏移（同上面 amqp / aop / resilience4j 那一族的处置）。 -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
