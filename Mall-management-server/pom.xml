<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>
    <groupId>com.minke</groupId>
    <artifactId>Mall-management-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>Mall-management-server</name>
    <description>Mall-management-server</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>17</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.33</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.46</version>
            <scope>provided</scope>
        </dependency>

        <!-- 缓存抽象（@Cacheable 注解支持） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- Caffeine 本地缓存（一级） -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Redis 客户端（二级） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Lettuce 连接池（spring.data.redis.lettuce.pool.* 生效前提） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- 可观测性（C1）：Actuator 提供 /actuator/metrics 等端点，Micrometer 由它带入
             （micrometer-core 是 starter 的传递依赖，无需单独声明；不引入 Prometheus registry
             —— 本项目没有拉取式抓取方，加它只是多一个依赖）。埋点见 MallCacheMetrics。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 校验层（笔 3）：提供 Hibernate Validator（JSR-380 实现），即 Spring 的 Validator bean。
             ⚠️ 只为「控制器方法参数上的约束注解」供 bean —— 不在任何 Controller 上加**类级**
             {@code @Validated}：那会经 MethodValidationPostProcessor 建 CGLIB 代理，被
             MallManagementApplicationTests 的 4 条 xxxControllerIsNotAopProxied 断言禁止。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 分布式锁（B2）：Redisson 的**核心**包，刻意不用 redisson-spring-boot-starter。
             理由不是风格偏好：starter 的 RedissonAutoConfigurationV2 会注册自己的
             RedissonConnectionFactory，而 Boot 的 Lettuce 工厂是
             @ConditionalOnMissingBean(RedisConnectionFactory.class) ⇒ **Lettuce 被静默顶掉**
             （a3 的连接池与 spring.data.redis.timeout 一并失效，且 A3 上看不出来）——
             与 L2ProbeConfig 类注释警告的是同一种失效形态。核心包绕开自动装配，配置从
             RedisProperties 派生（同源 ⇒ 不存在「改了配置只改一处」的漂移）。
             同理不引 redisson-spring-data-34：那是给 Redisson 版 CacheManager /
             ConnectionFactory 用的，本项目两个都不需要。

             版本 3.46.0 的取舍（依据可复核）：Boot 3.4.5 的 dependencyManagement 把
             io.netty 统一到 4.1.119.Final（spring-boot-dependencies-3.4.5.pom:154），
             而 Maven Central 上 redisson-parent 声明的是 3.46.0 → 4.1.118（被向上抬，
             补丁级、向后兼容）、3.47.0~3.50.0 → 4.1.121（会被**向下**压到 4.1.119）——
             降级方向才是 NoSuchMethodError 的风险面，故取 3.46.0。
             复核命令：./mvnw dependency:tree -Dincludes=io.netty 应显示 4.1.119.Final。 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>3.46.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
