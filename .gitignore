# 前端
**/node_modules/
**/dist/
**/.vite/
**/*.local

# 后端
**/target/
**/build/
**/.gradle/
**/*.log

# IDE
.idea/
.vscode/
*.iml

# 系统
.DS_Store
Thumbs.db

# 非代码文件
*.docx

# 日志
logs/
*.tmp

# A3 并发测试临时产物
# 每次运行生成新文件（report-<runId>.json / .md），不入库
# classpath.txt 由 mvn dependency:build-classpath 生成
# 注：scripts/concurrency/*.log 已由 **/*.log 规则覆盖，此处不重复
scripts/concurrency/reports/
scripts/concurrency/classpath.txt

# A3 run.sh 的编译产物目录（javac -encoding UTF-8 两步编译的输出）
.a3-out/

# 「文件:行号」互引扫描器的产物
# 脚本 scripts/refs-scan.sh 进仓（可复跑）；before/after 是每次运行的快照，不入库
scripts/refs-before.txt
scripts/refs-after.txt
